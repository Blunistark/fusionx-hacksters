# FusionX Streamlit Frontend - Environment Configuration
# 
# Copy this file to .env and fill in your API keys
# This file should NEVER be committed to version control
#
# Getting API Keys:
# 1. OpenAI: https://platform.openai.com/api-keys
# 2. Google Gemini: https://aistudio.google.com/apikey
# 3. Anthropic Claude: https://console.anthropic.com/account/keys

# OpenAI API Key (for GPT-4o-mini)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API Key (for Gemini 1.5 Flash)
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-gemini-api-key-here

# Anthropic Claude API Key (for Claude 3.5)
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Event API Endpoint (if using external event service)
# EVENT_API_ENDPOINT=http://localhost:8000/events

# Optional: Commentary API Endpoint (if using external commentary service)
# COMMENTARY_API_ENDPOINT=http://localhost:8001/commentary

# Optional: Enable debug mode for verbose logging
# DEBUG_MODE=false

# Optional: Custom Streamlit configuration
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=localhost
# STREAMLIT_LOGGER_LEVEL=info

# Note: After updating this file, restart the Streamlit app for changes to take effect
